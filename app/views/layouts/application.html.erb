<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OmniPOS — Universal Terminal</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% begin %>
      <%= vite_client_tag %>
      <%= vite_javascript_tag 'application' %>
    <% rescue StandardError => e %>
      <!-- Vite asset placeholder: <%= e.class %> -->
    <% end %>
    <%= inertia_ssr_head %>
  </head>
  <body class="bg-gray-900 text-gray-100 antialiased font-sans min-h-screen">
    <%= yield %>
  </body>
</html>
